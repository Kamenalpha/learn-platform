# 复制本文件为 .env 并填入真实 Key(docker compose 自动读取; .env 已在 .gitignore 中,勿提交)

# ---- 生成大模型(必填):问答/出题/AI 评分/项目拆解/变式训练 ----
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 嵌入模型(必填):文档向量化与语义检索 ----
EMBED_API_KEY=sk-your-key
EMBED_BASE_URL=https://api.siliconflow.cn
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# ---- 可选 ----
# 重排 Key,为空则关闭重排(通常复用 EMBED_API_KEY 即可)
RERANK_API_KEY=
# 扫描件 OCR 服务地址(PaddleOCR),为空关闭 OCR
OCR_BASE_URL=
# MySQL root 密码(compose 中 MySQL 与后端共用)
DB_PASSWORD=root123456

# ---- 每月 AI 用量配额(按用户;0 表示该项不限) ----
QUOTA_ENABLED=true
# QUOTA_CHAT_LIMIT=200
# QUOTA_GENERATE_LIMIT=30
# QUOTA_GRADE_LIMIT=200
# QUOTA_PROJECT_LIMIT=10
# QUOTA_GRAPH_LIMIT=30
